{
  "expo": {
    "name": "FinFit",
    "slug": "finfit",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finfit",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101010"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.Kharshit801.finfit",
      "buildNumber": "1.1.0",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "gpay",
          "phonepe",
          "paytm",
          "bhim",
          "upi"
        ],
        "NSCameraUsageDescription": "This app needs camera access to scan QR codes for payments",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "finfit"
            ]
          }
        ],
        "NSFaceIDUsageDescription": "This app uses Face ID to secure your data."
      }
    },
    "android": {
      "package": "com.Kharshit801.finfit",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#101010"
      },
      "permissions": [
        "QUERY_ALL_PACKAGES",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC"
      ],
      "queries": {
        "packages": [
          "com.google.android.apps.nbu.paisa.user",
          "net.one97.paytm",
          "com.phonepe.app",
          "in.org.npci.upiapp",
          "com.dreamplug.androidapp"
        ]
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "upi"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "notifications": {
        "icon": "./assets/images/notification-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
